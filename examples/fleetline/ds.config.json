    "platforms": [
      "web",
      "tablet"
    ],
    "brand_inputs": "",
    "existing_assets": "",
    "constraints": "High readability outdoors; large touch targets on tablet; WCAG 2.2 AA",
    "a11y_target": "WCAG 2.2 AA"
  },
  "direction": {
    "mode": "new",
    "reference_system": "",
    "style": "Calm, functional, high-legibility. Teal brand for actions only; neutral slate surfaces; one shape language (8px radius).",
    "palette": "Teal #0f766e via ds.py palette (OKLCH ramp, contrast-mapped)",
    "typography": "Inter for UI; tabular numerals for data",
    "rationale": "Work tool used for hours a day and outdoors: contrast and density over decoration. Teal reads as 'operational' and stays distinct from status colors (red/amber/green).",
    "allocation": []
  },
  "principles": [
    "Legible first: contrast and size beat decoration.",
    "One primary action per region.",
    "Status is never color alone.",
    "Native HTML before JavaScript."
  ],
  "motion": {
    "personality": "quick and quiet",
    "bans": [
      "parallax",
      "bounce/spring easing",
      "autoplay"
    ],
    "moments": [
      "overlay enter: fade + 8px rise, motion.duration.base"
    ]
  },
  "targets": [
    "html-css"
  ],
  "package_name": "",
  "version": "0.1.0",
  "decisions": [
    {
      "id": "ADR-001",
      "date": "2026-10-08",
      "title": "New direction with teal brand",
      "context": "No existing designs; dispatch + workshop users",
      "decision": "mode=new; teal ramp generated from #0f766e and mapped by contrast",
      "consequences": "Primary = teal-700 light / teal-400 dark; status colors stay red/amber/green"
    }
  ],
