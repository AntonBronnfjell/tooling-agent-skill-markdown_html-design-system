        "value": 80,
        "unit": "rem"
      }
    },
    "2xl": {
      "$value": {
        "value": 96,
        "unit": "rem"
      }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": {
      "$value": 0.5
    },
    "hover-overlay": {
      "$value": 0.08
    },
    "pressed-overlay": {
      "$value": 0.12
    }
  }
}
