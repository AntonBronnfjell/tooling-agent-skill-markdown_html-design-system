    "ai": {
      "accent": {
        "$value": "{color.violet.600}",
        "$description": "AI icons, AI label text/border, sparkle glyph. 5.70:1 on white."
      },
      "accent-strong": {
        "$value": "{color.violet.700}",
        "$description": "AI accent used as small text/links. 7.10:1 on white."
      },
      "fg-on-accent": {
        "$value": "{color.gray.0}",
        "$description": "Text on solid color.ai.accent (5.70:1)."
      },
      "surface": {
        "$value": "{color.violet.50}",
        "$description": "Tinted background for AI-generated regions (assistant bubble optional, AI fields, approval cards). Text on it: color.text.default."
      },
      "surface-strong": {
        "$value": "{color.violet.100}",
        "$description": "Hover/selected on AI surfaces."
      },
      "border": {
        "$value": "{color.violet.200}",
        "$description": "Decorative border of AI surfaces (not a 3:1 UI boundary \u2014 pair with color.border.default when the edge identifies a control)."
      },
      "border-strong": {
        "$value": "{color.violet.500}",
        "$description": "AI-highlighted control edge / focus-adjacent glow (4.23:1 on white, \u22653:1 for UI)."
      },
      "fg": {
        "$value": "{color.violet.800}",
        "$description": "Text on color.ai.surface (8.19:1)."
      },
      "shimmer-base": {
        "$value": "{color.text.muted}",
        "$description": "Base color of shimmer text; the highlight sweep must never reduce text below 4.5:1 at any frame."
      },
      "shimmer-highlight": {
        "$value": "{color.text.default}"
      },
      "user-bubble-bg": {
        "$value": "{color.bg.muted}",
        "$description": "User message bubble; assistant messages default to no bubble (canvas)."
      },
      "user-bubble-fg": {
        "$value": "{color.text.default}"
      },
      "caret": {
        "$value": "{color.ai.accent}",
        "$description": "Streaming cursor."
      },
      "citation-bg": {
        "$value": "{color.bg.muted}"
      },
      "citation-fg": {
        "$value": "{color.text.link}"
      },
      "approval": {
        "border": {
          "$value": "{color.feedback.warning.border}"
        },
        "bg": {
          "$value": "{color.feedback.warning.bg}"
        },
        "destructive-border": {
          "$value": "{color.feedback.danger.border}"
        }
      },
      "tool": {
        "pending": {
          "$value": "{color.text.subtle}"
        },
        "running": {
          "$value": "{color.feedback.info.icon}"
        },
        "success": {
          "$value": "{color.feedback.success.icon}"
        },
        "error": {
          "$value": "{color.feedback.danger.icon}"
        }
      },
      "gradient-start": {
        "$value": "{color.violet.500}"
      },
      "gradient-mid": {
        "$value": "{color.blue.500}"
      },
      "gradient-end": {
        "$value": "{color.violet.300}"
      }
    }
  },
  "gradient": {
    "ai": {
      "$type": "gradient",
      "$description": "DTCG gradient type. UNCERTAIN: ds.py build's supported $type list (tokens.md \u00a72) does not include gradient \u2014 either add gradient support to the build or keep only the three color.ai.gradient-* stops and compose linear-gradient() in component CSS. Decorative only (AI label border, empty-state glyph, generating aura); never behind text.",
      "$value": [
        {
          "color": "{color.ai.gradient-start}",
          "position": 0
        },
        {
          "color": "{color.ai.gradient-mid}",
          "position": 0.5
        },
        {
          "color": "{color.ai.gradient-end}",
          "position": 1
        }
      ]
    }
  },
  "shadow": {
    "ai": {
      "glow": {
        "$type": "shadow",
        "$description": "Carbon-style subtle AI 'aura' on containers; light spread kept small so content contrast is unaffected. Removed in forced-colors and high-contrast.",
        "$value": {
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 12,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          },
          "color": {
            "colorSpace": "srgb",
            "components": [
              0.4863,
              0.2275,
              0.9294
            ],
            "alpha": 0.18,
            "hex": "#7c3aed"
          }
        }
      }
    }
  },
  "motion": {
    "ai": {
      "shimmer-duration": {
        "$type": "duration",
        "$value": {
          "value": 1600,
          "unit": "ms"
        },
        "$description": "One sweep of the shimmer highlight. Stops under prefers-reduced-motion (static muted text)."
      },
      "caret-blink": {
        "$type": "duration",
        "$value": {
          "value": 1000,
          "unit": "ms"
        }
      },
      "loading-delay": {
        "$type": "duration",
        "$value": {
          "value": 1000,
          "unit": "ms"
        },
        "$description": "Don't show a loading state for waits under ~1s (Cloudscape)."
      },
      "long-wait": {
        "$type": "duration",
        "$value": {
          "value": 8000,
          "unit": "ms"
        },
        "$description": "After this, show elapsed time / 'Still working' text. Value is a proposal."
      },
      "announce-throttle": {
        "$type": "duration",
        "$value": {
          "value": 1500,
          "unit": "ms"
        },
        "$description": "Minimum gap between live-region announcements of streamed text (flush on sentence end or this interval, whichever is later). Proposal; tune with screen-reader testing."
      }
    }
  },
  "size": {
    "ai": {
      "message-max-inline": {
        "$type": "dimension",
        "$value": {
          "value": 48,
          "unit": "rem"
        },
        "$description": "Max width of the conversation column (\u2248 size.container.md)."
      },
      "prompt-max-block": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "rem"
        },
        "$description": "Prompt input grows to this height, then scrolls."
      },
      "artifact-panel-inline": {
        "$type": "dimension",
        "$value": {
          "value": 40,
          "unit": "rem"
        }
      },
      "copilot-panel-inline": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "rem"
        }
      },
      "avatar": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "rem"
        }
      }
    }
  },
  "radius": {
    "ai": {
      "bubble": {
        "$type": "dimension",
        "$value": "{radius.xl}"
      },
      "chip": {
        "$type": "dimension",
        "$value": "{radius.full}"
      },
      "card": {
        "$type": "dimension",
        "$value": "{radius.lg}"
      }
    }
  }
}
