{
  "$description": "Playback scope tokens (added by ds.py init when playback is enabled, directly or via video/live/music/podcast/reading/messaging). The media surface is always dark in every theme.",
  "color": {
    "$type": "color",
    "media": {
      "surface": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0431,
            0.0431,
            0.0588
          ],
          "hex": "#0b0b0f"
        },
        "$description": "Player surface: always dark in every theme (video letterbox, control bar)."
      },
      "scrim": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0,
            0.0,
            0.0
          ],
          "hex": "#000000"
        },
        "$description": "Caption/control scrim behind text. Opaque here; apply alpha in CSS only when the measured result still meets 4.5:1."
      },
      "fg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1.0,
            1.0,
            1.0
          ],
          "hex": "#ffffff"
        },
        "$description": "Icons and text on the player. 19.65:1 on surface, 21.0:1 on scrim."
      },
      "track": {
        "rail": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.2902,
              0.2902,
              0.3373
            ],
            "hex": "#4a4a56"
          },
          "$description": "Seek/volume track rail."
        },
        "buffered": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.6039,
              0.6039,
              0.6588
            ],
            "hex": "#9a9aa8"
          },
          "$description": "Buffered range."
        },
        "played": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.5412,
              0.7059,
              1.0
            ],
            "hex": "#8ab4ff"
          },
          "$description": "Played range; 4.18:1 against rail (3:1 UI minimum)."
        }
      },
      "live": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1.0,
            0.3529,
            0.3529
          ],
          "hex": "#ff5a5a"
        },
        "$description": "LIVE badge/edge marker; 6.42:1 on surface. Always with the text LIVE."
      },
      "focus": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1.0,
            0.8392,
            0.0392
          ],
          "hex": "#ffd60a"
        },
        "$description": "Focus ring on media controls; 13.92:1 on surface."
      }
    }
  }
}
